<div class="flex h-full flex-col bg-gray-50 dark:bg-gray-900">
    <section class="flex-shrink-0 border-b border-gray-200 bg-white px-4 py-4 shadow-sm dark:border-gray-700 dark:bg-gray-900 dark:shadow-sm dark:shadow-black/30 md:px-6">
        <div class="mx-auto flex w-full max-w-6xl flex-col gap-3 md:flex-row md:items-start md:justify-between">
            <div class="min-w-0">
                <div class="text-xs font-semibold uppercase text-gray-400 dark:text-gray-500">{{t "ledger-ui.s.payment-gateway-setup"}}</div>
                <h1 class="truncate text-lg font-bold text-gray-900 dark:text-gray-100">{{t "ledger-ui.s.edit"}} {{@model.name}}</h1>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-300">{{t "ledger-ui.s.review-provider-credentials-routing-status-webho"}}</p>
            </div>
            <div class="flex flex-shrink-0 items-center gap-2">
                <Button @icon="eye" @text={{t "ledger-ui.s.view"}} @size="sm" @onClick={{this.view}} />
                <Button @icon="times" @text={{t "ledger-ui.s.cancel"}} @size="sm" @onClick={{this.cancel}} />
            </div>
        </div>
    </section>

    <Gateway::Form
        @resource={{@model}}
        @saveLabel="Save Gateway"
        @footerHelp="Changes affect future invoice checkout, refunds, webhook routing, and diagnostics."
        @isSaving={{this.save.isRunning}}
        @onCancel={{this.cancel}}
        @onSave={{perform this.save @model}}
    />
</div>
