<Layout::Section::Header @title={{t "ledger-ui.s.accounting-settings"}}>
    <Button
        @type="primary"
        @size="sm"
        @icon="save"
        @text={{t "ledger-ui.s.save-changes"}}
        @onClick={{perform this.saveSettings}}
        @disabled={{this.saveSettings.isRunning}}
        @isLoading={{or this.saveSettings.isRunning this.getSettings.isRunning}}
    />
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll h-full">
    <div class="container mx-auto h-screen">
        <div class="max-w-3xl my-10 mx-auto space-y-6">

            {{! ── Base Currency & Fiscal Year ────────────────────────────────────── }}
            <ContentPanel @title={{t "ledger-ui.s.currency-fiscal-year"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name="Base Currency" @helpText={{t "ledger-ui.s.the-reporting-currency-for-all-financial-stateme"}}>
                    <CurrencySelect
                        @currency={{this.effectiveCurrency}}
                        @currencyData={{this.selectedCurrency}}
                        @onCurrencyChange={{this.onSelectCurrency}}
                        @triggerClass="form-select form-input"
                        @placeholder={{concat "Default: " this.companyCurrency}}
                        @allowClear={{true}}
                    />
                    {{#unless this.base_currency}}
                        <p class="text-xs text-gray-400 mt-1">{{t "ledger-ui.s.using-organisation-default"}}{{this.companyCurrency}}{{t "ledger-ui.s.select-a-currency-above-to-override"}}</p>
                    {{/unless}}
                </InputGroup>

                <InputGroup @name="Fiscal Year Start Month" @helpText={{t "ledger-ui.s.the-month-in-which-your-organisation-s-fiscal-ye"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.fiscalYearMonthOptions}}
                            @selected={{find-by "value" this.fiscal_year_start_month this.fiscalYearMonthOptions}}
                            @onChange={{this.onSelectFiscalYearMonth}}
                            @placeholder={{t "ledger-ui.s.select-start-month"}}
                            @triggerClass="form-select form-input"
                            as |opt|
                        >
                            <div class="text-sm">{{opt.label}}</div>
                        </PowerSelect>
                    </div>
                </InputGroup>
            </ContentPanel>

            {{! ── Default Accounts ────────────────────────────────────────────────── }}
            <ContentPanel @title={{t "ledger-ui.s.default-accounts"}} @open={{true}} @wrapperClass="bordered-classic">
                <div class="text-xs text-gray-500 mb-3">
                    {{t "ledger-ui.s.these-accounts-are-used-automatically-when-posti"}}
                </div>

                <InputGroup @name="Default Revenue Account" @helpText={{t "ledger-ui.s.applied-to-income-line-items-on-invoices-and-sal"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.revenueAccounts}}
                            @selected={{this.selectedRevenueAccount}}
                            @onChange={{this.onSelectRevenueAccount}}
                            @placeholder={{t "ledger-ui.s.select-revenue-account"}}
                            @triggerClass="form-select form-input"
                            @allowClear={{true}}
                            as |account|
                        >
                            <div class="flex items-center justify-between text-sm">
                                <span class="font-medium">{{account.name}}</span>
                                {{#if account.code}}
                                    <span class="text-gray-400 text-xs ml-2 font-mono">{{account.code}}</span>
                                {{/if}}
                            </div>
                        </PowerSelect>
                    </div>
                </InputGroup>

                <InputGroup @name="Default Expense Account" @helpText={{t "ledger-ui.s.applied-to-cost-and-expense-line-items-on-bills"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.expenseAccounts}}
                            @selected={{this.selectedExpenseAccount}}
                            @onChange={{this.onSelectExpenseAccount}}
                            @placeholder={{t "ledger-ui.s.select-expense-account"}}
                            @triggerClass="form-select form-input"
                            @allowClear={{true}}
                            as |account|
                        >
                            <div class="flex items-center justify-between text-sm">
                                <span class="font-medium">{{account.name}}</span>
                                {{#if account.code}}
                                    <span class="text-gray-400 text-xs ml-2 font-mono">{{account.code}}</span>
                                {{/if}}
                            </div>
                        </PowerSelect>
                    </div>
                </InputGroup>

                <InputGroup @name="Default Accounts Receivable (AR) Account" @helpText={{t "ledger-ui.s.the-asset-account-that-tracks-money-owed-to-your"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.arAccounts}}
                            @selected={{this.selectedArAccount}}
                            @onChange={{this.onSelectArAccount}}
                            @placeholder={{t "ledger-ui.s.select-ar-account"}}
                            @triggerClass="form-select form-input"
                            @allowClear={{true}}
                            as |account|
                        >
                            <div class="flex items-center justify-between text-sm">
                                <span class="font-medium">{{account.name}}</span>
                                {{#if account.code}}
                                    <span class="text-gray-400 text-xs ml-2 font-mono">{{account.code}}</span>
                                {{/if}}
                            </div>
                        </PowerSelect>
                    </div>
                </InputGroup>

                <InputGroup @name="Default Accounts Payable (AP) Account" @helpText={{t "ledger-ui.s.the-liability-account-that-tracks-money-your-org"}}>
                    <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                        <PowerSelect
                            @options={{this.apAccounts}}
                            @selected={{this.selectedApAccount}}
                            @onChange={{this.onSelectApAccount}}
                            @placeholder={{t "ledger-ui.s.select-ap-account"}}
                            @triggerClass="form-select form-input"
                            @allowClear={{true}}
                            as |account|
                        >
                            <div class="flex items-center justify-between text-sm">
                                <span class="font-medium">{{account.name}}</span>
                                {{#if account.code}}
                                    <span class="text-gray-400 text-xs ml-2 font-mono">{{account.code}}</span>
                                {{/if}}
                            </div>
                        </PowerSelect>
                    </div>
                </InputGroup>
            </ContentPanel>

            {{! ── Journal Entry Behaviour ────────────────────────────────────────────── }}
            <ContentPanel @title={{t "ledger-ui.s.journal-entry-behaviour"}} @open={{true}} @wrapperClass="bordered-classic">
                <InputGroup @name="Auto-Post Journal Entries">
                    <Toggle
                        @isToggled={{this.auto_post_journal_entries}}
                        @label={{t "ledger-ui.s.automatically-post-journal-entries-to-the-genera"}}
                        @onToggle={{fn (mut this.auto_post_journal_entries)}}
                    />
                </InputGroup>
            </ContentPanel>
        </div>
        <Spacer @height="600px" />
    </div>
</Layout::Section::Body>